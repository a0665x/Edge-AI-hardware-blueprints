  <diagram id="validation" name="03 Compatibility and acceptance">
    <mxGraphModel dx="1250" dy="740" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1250" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="spec" value="G0: Requirements and dataset&#10;Error cost / resolution / deadline" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#e9f1eb;strokeColor=#9eb9ab;fontColor=#143f39;fontSize=17;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
