          <mxGeometry x="455" y="50" width="280" height="86" as="geometry" />
        </mxCell>
        <mxCell id="op" value="G2: Compilation and quantization gate&#10;Operator attributes / fallback / accuracy" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#e9f1eb;strokeColor=#9eb9ab;fontColor=#143f39;fontSize=17;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="50" width="280" height="86" as="geometry" />
        </mxCell>
        <mxCell id="perf" value="G3: End-to-end performance&#10;Multiple streams / P95,P99 / frame age" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#e9f1eb;strokeColor=#9eb9ab;fontColor=#143f39;fontSize=17;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="238" width="280" height="86" as="geometry" />
        </mxCell>
        <mxCell id="thermal" value="G4: Thermal and concurrency stress&#10;Power / throttling / peak memory" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#e9f1eb;strokeColor=#9eb9ab;fontColor=#143f39;fontSize=17;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="455" y="238" width="280" height="86" as="geometry" />
        </mxCell>
        <mxCell id="release" value="G5: Maintenance and production&#10;Update regression / BSP / cost / supply" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#e9f1eb;strokeColor=#9eb9ab;fontColor=#143f39;fontSize=17;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="238" width="280" height="86" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="Fail: revisit requirements or technology&#10;Change model / data path / platform" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#fff1e5;strokeColor=#b75a2b;fontColor=#143f39;fontSize=17;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="455" y="430" width="280" height="90" as="geometry" />
